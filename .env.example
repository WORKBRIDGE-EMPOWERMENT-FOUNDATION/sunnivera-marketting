# SMTP account that sends the enquiry email (use the mailbox you already have)
SMTP_HOST=mail.suniveralogisticsltd.com
SMTP_PORT=465
SMTP_USER=hello@suniveralogisticsltd.com
SMTP_PASS=your-mailbox-password
# Where enquiries are delivered (defaults to hello@suniveralogisticsltd.com)
CONTACT_TO=hello@suniveralogisticsltd.com
# Optional. Defaults to the SMTP_USER address
# CONTACT_FROM=Sunivera Website <hello@suniveralogisticsltd.com>
