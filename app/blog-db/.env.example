# SMTP account that sends the enquiry email (use the mailbox you already have)
SMTP_HOST=mail.suniveralogisticsltd.com
SMTP_PORT=465
SMTP_USER=info@suniveralogisticsltd.com
SMTP_PASS=your-mailbox-password
# Where enquiries are delivered (defaults to info@suniveralogisticsltd.com)
CONTACT_TO=info@suniveralogisticsltd.com
# Optional. Defaults to the SMTP_USER address
# CONTACT_FROM=Sunivera Website <info@suniveralogisticsltd.com>

# Public site URL (used for sitemap and share links)
NEXT_PUBLIC_SITE_URL=https://suniveralogisticsltd.com

# Blog database (Postgres, e.g. Supabase or Neon free tier)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Admin login at /admin. Make AUTH_SECRET long and random (openssl rand -hex 32)
ADMIN_PASSWORD=choose-a-strong-password
AUTH_SECRET=replace-with-64-random-hex-characters
